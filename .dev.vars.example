# ============================================
# fufu-rs 环境变量示例
# 复制为 .env 或通过 wrangler secret put 设置
# ============================================

# --- JWT ---
JWT_SECRET=your-jwt-secret-here

# --- GitHub（文章评论数） ---
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_REPO=user/repo

# --- 百度翻译 ---
BAIDU_TRANSLATE_APPID=your-app-id
BAIDU_TRANSLATE_SECRET=your-secret

# --- Umami 统计 ---
UMAMI_API_URL=https://analytics.fufu.moe
UMAMI_USERNAME=admin
UMAMI_PASSWORD=your-password
UMAMI_WEBSITE_ID=your-website-uuid
