### ═══════════════════════════════════════════════════════════
### fufu-rs API 测试
### 使用 VSCode REST Client 插件 (humao.rest-client)
### 先启动服务: wrangler dev --port 8787
### ═══════════════════════════════════════════════════════════

@baseUrl = http://localhost:8787
@accessToken = {{login.response.body.access_token}}
@slug = test-post
@postId = test-post
@friendId = 00000000-0000-0000-0000-000000000000
@galleryId = 00000000-0000-0000-0000-000000000000
@photoId = 00000000-0000-0000-0000-000000000000

### ───────────────────────────────────────────────────────────
### 1. 健康检查
### ─────────────────────────────────────────────────────────

### GET /api/health
GET {{baseUrl}}/api/health

### ───────────────────────────────────────────────────────────
### 2. 身份验证
### ─────────────────────────────────────────────────────────

### POST /api/auth/login
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
    "email": "admin@example.com",
    "password": "your-password"
}

### POST /api/auth/login/2fa (如果需要 TOTP)
POST {{baseUrl}}/api/auth/login/2fa
Content-Type: application/json

{
    "temp_token": "{{login.response.body.temp_token}}",
    "code": "123456"
}

### POST /api/auth/login/verify (如果使用邮箱验证码)
POST {{baseUrl}}/api/auth/login/verify
Content-Type: application/json

{
    "temp_token": "{{login.response.body.temp_token}}",
    "code": "123456"
}

### POST /api/auth/refresh
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
    "refresh_token": "your-refresh-token"
}

### GET /api/auth/me
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{accessToken}}

### POST /api/auth/logout
POST {{baseUrl}}/api/auth/logout
Authorization: Bearer {{accessToken}}

### POST /api/auth/2fa/setup (需登录)
POST {{baseUrl}}/api/auth/2fa/setup
Authorization: Bearer {{accessToken}}

### POST /api/auth/2fa/verify (确认开启 2FA)
POST {{baseUrl}}/api/auth/2fa/verify
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "code": "123456"
}

### POST /api/auth/2fa/disable (关闭 2FA)
POST {{baseUrl}}/api/auth/2fa/disable
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "password": "your-password"
}

### ───────────────────────────────────────────────────────────
### 3. 站点设置
### ─────────────────────────────────────────────────────────

### GET /api/settings/profile
GET {{baseUrl}}/api/settings/profile

### PUT /api/settings/profile (需登录)
PUT {{baseUrl}}/api/settings/profile
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "site_name": "我的博客",
    "description": "个人技术博客",
    "avatar_url": "https://example.com/avatar.png",
    "email": "admin@example.com"
}

### GET /api/settings/footer
GET {{baseUrl}}/api/settings/footer

### PUT /api/settings/footer (需登录)
PUT {{baseUrl}}/api/settings/footer
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "copyright": "© 2026 My Blog",
    "icp": "京ICP备00000000号"
}

### GET /api/settings/footer-links
GET {{baseUrl}}/api/settings/footer-links

### POST /api/settings/footer-links (需登录)
POST {{baseUrl}}/api/settings/footer-links
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "name": "关于我们",
    "url": "/about",
    "sort_order": 1
}

### PUT /api/settings/footer-links/{id} (需登录)
PUT {{baseUrl}}/api/settings/footer-links/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "name": "关于我们（更新）",
    "sort_order": 2
}

### DELETE /api/settings/footer-links/{id} (需登录)
DELETE {{baseUrl}}/api/settings/footer-links/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{accessToken}}

### GET /api/settings/social-links
GET {{baseUrl}}/api/settings/social-links

### POST /api/settings/social-links (需登录)
POST {{baseUrl}}/api/settings/social-links
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "name": "GitHub",
    "url": "https://github.com/username",
    "icon": "github",
    "sort_order": 1
}

### PUT /api/settings/social-links/{id} (需登录)
PUT {{baseUrl}}/api/settings/social-links/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "name": "GitHub（更新）"
}

### DELETE /api/settings/social-links/{id} (需登录)
DELETE {{baseUrl}}/api/settings/social-links/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{accessToken}}

### GET /api/settings/announcements
GET {{baseUrl}}/api/settings/announcements

### POST /api/settings/announcements (需登录)
POST {{baseUrl}}/api/settings/announcements
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "content": "站点维护通知",
    "sort_order": 1
}

### PUT /api/settings/announcements/{id} (需登录)
PUT {{baseUrl}}/api/settings/announcements/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "content": "站点维护通知（更新）"
}

### DELETE /api/settings/announcements/{id} (需登录)
DELETE {{baseUrl}}/api/settings/announcements/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{accessToken}}

### ───────────────────────────────────────────────────────────
### 4. 博客模块
### ─────────────────────────────────────────────────────────

### GET /api/posts
GET {{baseUrl}}/api/posts?page=1&page_size=10

### GET /api/posts?tag=rust
GET {{baseUrl}}/api/posts?tag=rust

### POST /api/posts (需登录)
POST {{baseUrl}}/api/posts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "title": "测试文章",
    "slug": "test-post",
    "content": "# 测试\n\n这是一篇测试文章",
    "excerpt": "测试文章摘要",
    "tags": ["rust", "web"],
    "status": "published"
}

### GET /api/posts/{slug}
GET {{baseUrl}}/api/posts/test-post

### PUT /api/posts/{slug} (需登录)
PUT {{baseUrl}}/api/posts/test-post
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "title": "测试文章（更新）",
    "content": "# 更新\n\n内容已更新"
}

### POST /api/posts/{slug}/views
POST {{baseUrl}}/api/posts/test-post/views

### GET /api/posts/{slug}/comments-count
GET {{baseUrl}}/api/posts/test-post/comments-count

### DELETE /api/posts/{slug} (需登录)
DELETE {{baseUrl}}/api/posts/test-post
Authorization: Bearer {{accessToken}}

### ───────────────────────────────────────────────────────────
### 5. 点赞系统
### ─────────────────────────────────────────────────────────

### POST /api/likes/{type}/{id} — 点赞 toggle
POST {{baseUrl}}/api/likes/post/test-post

### GET /api/likes/{type}/{id} — 获取点赞数
GET {{baseUrl}}/api/likes/post/test-post

### ───────────────────────────────────────────────────────────
### 6. 友人帐
### ─────────────────────────────────────────────────────────

### GET /api/friends
GET {{baseUrl}}/api/friends?page=1&page_size=20

### POST /api/friends (需登录 / 可公开提交)
POST {{baseUrl}}/api/friends
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "name": "友链名称",
    "url": "https://example.com",
    "avatar_url": "https://example.com/avatar.png",
    "description": "友链描述",
    "email": "webmaster@example.com"
}

### GET /api/friends/{id}
GET {{baseUrl}}/api/friends/{{friendId}}

### PUT /api/friends/{id} (需登录)
PUT {{baseUrl}}/api/friends/{{friendId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "name": "友链名称（更新）",
    "sort_order": 1
}

### PATCH /api/friends/{id}/status (需登录)
PATCH {{baseUrl}}/api/friends/{{friendId}}/status
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "status": "approved"
}

### DELETE /api/friends/{id} (需登录)
DELETE {{baseUrl}}/api/friends/{{friendId}}
Authorization: Bearer {{accessToken}}

