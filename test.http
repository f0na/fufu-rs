### ─────────────────────────────────────────────────────────

### GET /api/links
GET {{baseUrl}}/api/links?page=1&page_size=20

### GET /api/links?tag=rust
GET {{baseUrl}}/api/links?tag=rust

### GET /api/links/meta
GET {{baseUrl}}/api/links/meta

### POST /api/links (需登录)
POST {{baseUrl}}/api/links
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "title": "Rust 官方文档",
    "url": "https://www.rust-lang.org/",
    "description": "Rust 编程语言官方网站",
    "tags": ["rust", "programming"],
    "sort_order": 1
}

### GET /api/links/{id}
GET {{baseUrl}}/api/links/00000000-0000-0000-0000-000000000000

### PUT /api/links/{id} (需登录)
PUT {{baseUrl}}/api/links/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "title": "Rust 官方文档（更新）",
    "description": "更新后的描述",
    "favorite": 1
}

### DELETE /api/links/{id} (需登录)
DELETE {{baseUrl}}/api/links/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{accessToken}}

### ───────────────────────────────────────────────────────────
### 8. 相册
### ─────────────────────────────────────────────────────────

### GET /api/galleries
GET {{baseUrl}}/api/galleries?page=1&page_size=20

### GET /api/galleries?tag=travel
GET {{baseUrl}}/api/galleries?tag=旅行

### POST /api/galleries (需登录)
POST {{baseUrl}}/api/galleries
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "title": "我的旅行相册",
    "cover_path": "/images/travel/cover.jpg",
    "tags": ["旅行", "摄影"]
}

### GET /api/galleries/{id}
GET {{baseUrl}}/api/galleries/{{galleryId}}

### PUT /api/galleries/{id} (需登录)
PUT {{baseUrl}}/api/galleries/{{galleryId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "title": "我的旅行相册（更新）"
}

### POST /api/galleries/{id}/photos (需登录)
POST {{baseUrl}}/api/galleries/{{galleryId}}/photos
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "paths": ["/images/travel/photo1.jpg", "/images/travel/photo2.jpg"]
}

### DELETE /api/photos/{id} (需登录)
DELETE {{baseUrl}}/api/photos/{{photoId}}
Authorization: Bearer {{accessToken}}

### DELETE /api/galleries/{id} (需登录)
DELETE {{baseUrl}}/api/galleries/{{galleryId}}
Authorization: Bearer {{accessToken}}

